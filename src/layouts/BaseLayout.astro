---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  /** Social preview image, site-relative. Falls back to the site-wide one. */
  image?: string;
  type?: 'website' | 'article';
}

const {
  title,
  canonical,
  image = '/og-default.png',
  type = 'website',
  description = 'Filippo De Luca — software engineer. Scala, Cats Effect, distributed systems, and a background in mechanical engineering.',
} = Astro.props;

// The home page is already titled "Filippo De Luca"; appending the site
// name there would print it twice.
const SITE_NAME = 'Filippo De Luca';
// Google Analytics 4. Public by nature — it ships in the page source — so it
// lives here rather than in an environment variable pretending to be a secret.
const GA_MEASUREMENT_ID = 'G-4NQKM71HY6';
const fullTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;
// og:url always points here, even when rel=canonical credits an earlier
// publication elsewhere: the two answer different questions.
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Filippo De Luca" href="/rss.xml" />
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <title>{fullTitle}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    {/* Production only: a dev server reloading on every keystroke would file
        those as real page views and quietly poison the numbers. */}
    {import.meta.env.PROD && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
        <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
          window.dataLayer = window.dataLayer || [];
          // Astro wraps inline scripts in an IIFE, so gtag has to be put on
          // window explicitly — otherwise custom events could never call it.
          window.gtag = function gtag() { dataLayer.push(arguments); };
          gtag('js', new Date());
          gtag('config', GA_MEASUREMENT_ID);
        </script>
      </>
    )}
  </head>
  <body>
    <nav class="site-nav">
      <div class="wrap">
        <a class="brand" href="/">filippodeluca<span style="color: var(--accent);">.</span>com</a>
        <ul>
          <li><a class="nav-link" href="/">home</a></li>
          <li><a class="nav-link" href="/about/">about</a></li>
          <li><a class="nav-link" href="/projects/">projects</a></li>
          <li><a class="nav-link" href="/blog/">blog</a></li>
        </ul>
      </div>
    </nav>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap title-block">
        <div class="tb-cell">
          <span class="eyebrow">Drawn by</span>
          <div class="tb-val">Filippo De Luca</div>
        </div>
        <div class="tb-cell">
          <span class="eyebrow">Contact</span>
          <div class="tb-val"><a href="mailto:me@filippodeluca.com">me@filippodeluca.com</a></div>
        </div>
        <div class="tb-cell">
          <span class="eyebrow">Elsewhere</span>
          <div class="tb-val">
            <a href="https://github.com/filosganga" target="_blank" rel="noopener">GitHub</a> ·
            <a href="https://www.linkedin.com/in/filippodeluca" target="_blank" rel="noopener">LinkedIn</a> ·
            <a href="/rss.xml">RSS</a>
          </div>
        </div>
        <div class="tb-cell">
          <span class="eyebrow">Rev.</span>
          <div class="tb-val">{new Date().getFullYear()}</div>
        </div>
      </div>
    </footer>
  </body>
</html>
